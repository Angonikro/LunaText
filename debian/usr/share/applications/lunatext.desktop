[Desktop Entry]
Version=1.0
Type=Application
Name=LunaText
GenericName=Text Editor
GenericName[de]=Texteditor
Comment=Qt6 Text Editor
Comment[de]=Qt6-Texteditor
Exec=/usr/bin/lunatext %F
TryExec=/usr/bin/lunatext
Icon=lunatext
Terminal=false
StartupNotify=true
Categories=Utility;TextEditor;
